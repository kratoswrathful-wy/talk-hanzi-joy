# 複製為 .env 後自行填入。此檔（.env.example）會進版控、對外公開，
# 只能放「欄位名 + 假佔位值」（如 your@email、sk-...），絕不可填真實帳密／金鑰。
# 真值只放本機 .env（已被 .gitignore 排除）或 GitHub Secrets / Vercel Project Settings。
#
# 給 AI 代理／協作者：禁止整檔覆寫使用者本機 .env、.env.playwright.local。
# 規則見 .cursor/rules/architecture.mdc §9「本機 .env 保護（強制）」。

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_key
VITE_SUPABASE_PROJECT_ID=your_project_id

# Optional: canonical origin for auth redirects (password reset, signup email links).
# Must match an entry in Supabase Authentication → URL Configuration → Redirect URLs
# (e.g. add https://tms.example.com/reset-password when using this origin).
# If unset, the app uses window.location.origin (current tab URL).
# VITE_SUPABASE_AUTH_REDIRECT_ORIGIN=https://tms.example.com

# Optional: Playwright E2E（CAT 2.3q 導覽、AI Bridge Phase 2）
# 建議：以下這幾行實際填寫時，優先放進本機另一個檔案 .env.playwright.local
# （同樣被 .gitignore 排除，playwright.config.ts 會自動一併讀取），與這份 .env 分開，
# 降低被整檔重寫時一併清空的機率。也可以直接填在 .env，效果相同，只是風險較高。
# PLAYWRIGHT_TEST_EMAIL=your@email   # 線上測試：真人執行長帳密（登入後自動進測試模式）
# PLAYWRIGHT_TEST_PASSWORD=your_password
# PLAYWRIGHT_BASE_URL=https://talk-hanzi-joy.vercel.app
# PLAYWRIGHT_ENTER_TEST_MODE=1   # 線上站：登入後切假執行長（env=test，與正式資料隔離）
# PLAYWRIGHT_ALLOW_PRODUCTION=1  # 僅在確定以正式身分跑時才設（一般不建議）
# PLAYWRIGHT_CAT_SMALL_FIXTURE=tests/fixtures/Test_Small.mqxliff
# PLAYWRIGHT_CAT_LARGE_FIXTURE=C:/Users/you/Downloads/Test_Big.mqxliff

# --- Server-only env（Vercel Project Settings / 本機 .env；勿加 VITE_ 前綴）---
# 以下僅供 Vercel serverless（api/*.js）與本機 dev proxy 使用，不得出現在前端 bundle。
# OPENAI_API_KEY=sk-...                          # /api/cat-openai、/api/cat-ai-model-sync
# SUPABASE_URL=https://your-project.supabase.co   # 或 fallback 讀 VITE_SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY=eyJ...                # service_role JWT；僅 server-side，絕不可 VITE_*

# --- Supabase Edge Functions secrets (set in Dashboard, not in Vite) ---
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_REDIRECT_URI=https://<project-ref>.supabase.co/functions/v1/slack-oauth-callback
# SITE_URL=https://your-frontend.vercel.app
